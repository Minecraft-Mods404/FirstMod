		"main": [
			"com.danielm.modid.FirstMod"
		],
		"client": [
			"com.danielm.modid.client.FirstModClient"
		]
	},
	"mixins": [
		"firstmod.mixins.json",
		{
			"config": "firstmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
