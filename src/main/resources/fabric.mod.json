{
	"schemaVersion": 1,
	"id": "firstmod",
	"version": "${version}",
	"name": "FirstMod",
	"description": "So much SLIME!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/firstmod/icon.png",
	"environment": "*",
